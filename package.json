    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
